diff --git a/qtbase/src/plugins/platforms/windows/qwindowspointerhandler.cpp b/qtbase/src/plugins/platforms/windows/qwindowspointerhandler.cpp
index 4d30ec0..857ab7d 100644
--- a/qtbase/src/plugins/platforms/windows/qwindowspointerhandler.cpp
+++ b/qtbase/src/plugins/platforms/windows/qwindowspointerhandler.cpp
@@ -43,12 +43,49 @@ QWindowsPointerHandler::~QWindowsPointerHandler()
 {
 }
 
+template<typename T, typename U>
+static QString dumpMapContent(const QHash<T, U>& p_map, bool p_dumpValue = true)
+{
+    QStringList entries;
+    entries.reserve(p_map.size());
+    for (auto it = p_map.cbegin(), end = p_map.cend(); it != end; ++it)
+    {
+        if (p_dumpValue)
+        {
+            entries.emplaceBack(QString::fromUtf8("%1 <-> %2")
+                                .arg(QVariant::fromValue(it.key()).toString())
+                                .arg(QVariant::fromValue(it.value()).toString()));
+        }
+        else
+        {
+            entries.emplaceBack(QString::fromUtf8("%1").arg(QVariant::fromValue(it.key()).toString()));
+        }
+    }
+
+    QString result;
+    QTextStream(&result) << "{ " << entries.join(QStringLiteral(", ")) << " }";
+    return result;
+}
+
 bool QWindowsPointerHandler::translatePointerEvent(QWindow *window, HWND hwnd, QtWindows::WindowsEventType et, MSG msg, LRESULT *result)
 {
     *result = 0;
     const quint32 pointerId = GET_POINTERID_WPARAM(msg.wParam);
 
     if (!GetPointerType(pointerId, &m_pointerType)) {
-        qWarning() << "GetPointerType() failed:" << qt_error_string();
+        qWarning()  << "GetPointerType() failed on pointerId:" << pointerId
+                    << ", m_touchInputIDToTouchPointID: " << dumpMapContent(m_touchInputIDToTouchPointID)
+                    << ", m_lastTouchPoints: " << dumpMapContent(m_lastTouchPoints, false)
+                    << ", error:" << qt_error_string();
+

+        int id = m_touchInputIDToTouchPointID.value(pointerId, -1);
+
+        if (id != -1)
+        {
+            if (m_lastTouchPoints.remove(id))
+            {
+                qInfo() << "Cleaning m_lastTouchPoints, successful removal of touchPointId:" << id;
+            }
+        }
+
         return false;
     }
